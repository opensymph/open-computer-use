# Normalize all text files to LF in the repository.
* text=auto eol=lf

# Windows scripts keep CRLF in the working tree.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaries
*.png binary
*.jpg binary
*.icns binary
*.ico binary
*.exe binary
*.zip binary
*.gz binary
*.dmg binary
*.webm binary
